# ============================================================
# Trading AI Agents — environment configuration
# Copy to .env and fill in the values you need.
# ============================================================

# --- Logging ---
TA_LOG_LEVEL=INFO

# --- Data provider ---
# yfinance | alpha_vantage | synthetic
TA_DATA_PROVIDER=yfinance
TA_ALPHAVANTAGE_KEY=
TA_CACHE_DIR=.cache/trading
TA_PERIOD=1y
TA_INTERVAL=1d
TA_TIMEOUT_SECONDS=30
TA_CACHE_TTL_SECONDS=300

# --- Risk ---
TA_MAX_POSITION_PCT=0.10
TA_MAX_PORTFOLIO_RISK_PCT=0.02
TA_DEFAULT_STOP_LOSS_PCT=0.05
TA_DEFAULT_TAKE_PROFIT_PCT=0.10
TA_ATR_MULT_STOP=2.0
TA_ATR_MULT_TARGET=3.0

# --- Backtest ---
TA_BACKTEST_CAPITAL=100000
TA_COMMISSION_PCT=0.001
TA_SLIPPAGE_PCT=0.0005
TA_BENCHMARK=^GSPC

# --- Sentiment ---
# Get a free key at https://newsapi.org/register
NEWS_API_KEY=
TA_SENTIMENT_LOOKBACK_DAYS=7
TA_SENTIMENT_USE_LLM=false

# --- Optional: config file for load_config() ---
# TA_CONFIG_PATH=config.yaml
